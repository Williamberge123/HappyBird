<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">

    <!-- Typsnitt som används för poäng och annan text -->
    <FontName>PixelifySans-Regular.ttf</FontName>

    <!-- Storlek på texten -->
    <Size>24</Size>

    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>

    <Style>Regular</Style>

    <!-- Tecken som ska kunna visas -->
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>

  </Asset>
</XnaContent>